;  fujinet-chainboot - helper for FujiNet ATR chain booting
;
;  Prototype D1:/D2: swap model:
;  - Read FujiNet device slots via device $70 command $F2 for host/mode
;  - Read the D1:/D2: full paths via command $DA
;  - Write swapped host/mode via command $F1
;  - Write swapped full paths via command $E2
;  - Mount all slots via command $D7
;
;  This mirrors the hisioboot-atarisio.atr flow: return C clear on
;  success so the boot initializer cleanup continues without RESET.

FN_CHAINBOOT
	LDX #<FN_PARAM_READ_SLOTS
	LDY #>FN_PARAM_READ_SLOTS
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	LDX #<FN_PARAM_GET_SLOT0
	LDY #>FN_PARAM_GET_SLOT0
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	LDX #<FN_PARAM_GET_SLOT1
	LDY #>FN_PARAM_GET_SLOT1
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	JSR FN_SWAP_SLOT_META
	LDX #<FN_PARAM_WRITE_SLOTS
	LDY #>FN_PARAM_WRITE_SLOTS
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	JSR FN_SET_SLOT0_AUX
	LDX #<FN_PARAM_SET_SLOT0
	LDY #>FN_PARAM_SET_SLOT0
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	JSR FN_SET_SLOT1_AUX
	LDX #<FN_PARAM_SET_SLOT1
	LDY #>FN_PARAM_SET_SLOT1
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	LDX #<FN_PARAM_MOUNT_ALL
	LDY #>FN_PARAM_MOUNT_ALL
	JSR FN_CALL_SIO
	BMI FN_CHAINBOOT_FAILED

	BPUT 0, TFNBOOTOKL, TFNBOOTOK
	CLC
	RTS

FN_CHAINBOOT_FAILED
	BPUT 0, TFNBOOTERRL, TFNBOOTERR
	SEC
	RTS

FN_CALL_SIO
	STX TMPVEC
	STY TMPVEC+1
	LDY #$0B
FN_CALL_SIO_L1
	LDA (TMPVEC),Y
	STA $300,Y
	DEY
	BPL FN_CALL_SIO_L1
	JMP PSTD	; bypass the installed highspeed dispatcher for $70 commands

FN_SWAP_SLOT_META
	LDA FN_SLOTBUF
	LDX FN_SLOTBUF+38
	STX FN_SLOTBUF
	STA FN_SLOTBUF+38
	LDA FN_SLOTBUF+37
	LDX FN_SLOTBUF+75
	STX FN_SLOTBUF+37
	STA FN_SLOTBUF+75
	RTS

FN_SET_SLOT0_AUX
	LDA FN_SLOTBUF
	ASL
	ASL
	ASL
	ASL
	ORA FN_SLOTBUF+37
	STA FN_PARAM_SET_SLOT0+11
	RTS

FN_SET_SLOT1_AUX
	LDA FN_SLOTBUF+38
	ASL
	ASL
	ASL
	ASL
	ORA FN_SLOTBUF+75
	STA FN_PARAM_SET_SLOT1+11
	RTS

FN_PARAM_READ_SLOTS
	.BYTE $70
	.BYTE $01
	.BYTE $F2
	.BYTE $40
	.WORD FN_SLOTBUF
	.BYTE $0F,0
	.WORD 304
	.WORD 0

FN_PARAM_GET_SLOT0
	.BYTE $70
	.BYTE $01
	.BYTE $DA
	.BYTE $40
	.WORD FN_PATH0
	.BYTE $0F,0
	.WORD 256
	.BYTE 0,0

FN_PARAM_GET_SLOT1
	.BYTE $70
	.BYTE $01
	.BYTE $DA
	.BYTE $40
	.WORD FN_PATH1
	.BYTE $0F,0
	.WORD 256
	.BYTE 1,0

FN_PARAM_WRITE_SLOTS
	.BYTE $70
	.BYTE $01
	.BYTE $F1
	.BYTE $80
	.WORD FN_SLOTBUF
	.BYTE $0F,0
	.WORD 304
	.WORD 0

FN_PARAM_SET_SLOT0
	.BYTE $70
	.BYTE $01
	.BYTE $E2
	.BYTE $80
	.WORD FN_PATH1
	.BYTE $0F,0
	.WORD 256
	.BYTE 0,0

FN_PARAM_SET_SLOT1
	.BYTE $70
	.BYTE $01
	.BYTE $E2
	.BYTE $80
	.WORD FN_PATH0
	.BYTE $0F,0
	.WORD 256
	.BYTE 1,0

FN_PARAM_MOUNT_ALL
	.BYTE $70
	.BYTE $01
	.BYTE $D7
	.BYTE $00
	.WORD 0
	.BYTE $0F,0
	.WORD 0
	.WORD 0

TFNBOOTOK	.BYTE "swapped FujiNet D1: and D2:",155
TFNBOOTOKL = * - TFNBOOTOK

TFNBOOTERR	.BYTE "FujiNet chain boot failed",155
TFNBOOTERRL = * - TFNBOOTERR

FN_SLOTBUF	.DC 304 0
FN_PATH0	.DC 256 0
FN_PATH1	.DC 256 0
